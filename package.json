{
  "name": "design-system",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "tokens:generate": "turbo run generate --filter=@design-system/tokens",
    "storybook": "pnpm --filter @design-system/docs dev",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
