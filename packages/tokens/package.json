{
  "name": "@design-system/tokens",
  "version": "0.0.0",
  "description": "Design system tokens: TypeScript source of truth with a custom generator for web (CSS) output.",
  "type": "module",
  "sideEffects": ["*.css"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./css": "./dist/variables.css",
    "./manifest": "./dist/manifest.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "generate": "tsx src/generate.ts",
    "build": "tsx src/generate.ts",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
