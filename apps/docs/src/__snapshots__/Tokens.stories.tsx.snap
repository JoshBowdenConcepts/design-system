        </figcaption>
      </figure>
      <figure style="margin: 0px;">
        <div style="height: 96px; background: var(--ds-color-primary-subtle); border: 2px solid var(--ds-color-primary); border-radius: var(--ds-radius-full);">
        </div>
        <figcaption style="margin-top: var(--ds-space-100);">
          <div style="font: var(--ds-type-label);">
