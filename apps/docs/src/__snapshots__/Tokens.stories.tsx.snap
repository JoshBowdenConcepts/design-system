exports[`Tokens Radius smoke-test 1`] = `
<div style="background: var(--ds-color-bg); color: var(--ds-color-text-primary); font: var(--ds-type-p); padding: 1.5rem; min-height: 100vh;">
  <div style="max-width: var(--ds-layout-max-width);">
    <h1 style="font: var(--ds-type-h1); margin: 0px 0px 0.5rem;">
      Radius
    </h1>
    <p style="font: var(--ds-type-p); color: var(--ds-color-text-secondary); max-width: var(--ds-layout-measure); margin: 0 0 var(--ds-space-600);">
      Ordinal steps in hundreds, plus radius.full for pills. 100 tags · 200 inputs · 300 cards · 400 sheets · full buttons / avatars.
    </p>
    <div style="display: grid; gap: var(--ds-space-300); grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));">
      <figure style="margin: 0px;">
        <div style="height: 96px; background: var(--ds-color-primary-subtle); border: 2px solid var(--ds-color-primary); border-radius: var(--ds-radius-100);">
        </div>
        <figcaption style="margin-top: var(--ds-space-100);">
          <div style="font: var(--ds-type-label);">
            radius.100
          </div>
          <div style="font: var(--ds-type-overline); color: var(--ds-color-text-secondary);">
            2px
          </div>
        </figcaption>
      </figure>
      <figure style="margin: 0px;">
        <div style="height: 96px; background: var(--ds-color-primary-subtle); border: 2px solid var(--ds-color-primary); border-radius: var(--ds-radius-200);">
        </div>
        <figcaption style="margin-top: var(--ds-space-100);">
          <div style="font: var(--ds-type-label);">
            radius.200
          </div>
          <div style="font: var(--ds-type-overline); color: var(--ds-color-text-secondary);">
            4px
          </div>
        </figcaption>
      </figure>
      <figure style="margin: 0px;">
        <div style="height: 96px; background: var(--ds-color-primary-subtle); border: 2px solid var(--ds-color-primary); border-radius: var(--ds-radius-300);">
        </div>
        <figcaption style="margin-top: var(--ds-space-100);">
          <div style="font: var(--ds-type-label);">
            radius.300
          </div>
          <div style="font: var(--ds-type-overline); color: var(--ds-color-text-secondary);">
            8px
          </div>
        </figcaption>
      </figure>
      <figure style="margin: 0px;">
        <div style="height: 96px; background: var(--ds-color-primary-subtle); border: 2px solid var(--ds-color-primary); border-radius: var(--ds-radius-400);">
        </div>
        <figcaption style="margin-top: var(--ds-space-100);">
          <div style="font: var(--ds-type-label);">
            radius.400
