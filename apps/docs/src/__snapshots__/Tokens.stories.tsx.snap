        <div style="width: 64px; font: var(--ds-type-overline); color: var(--ds-color-text-secondary);">
          4rem
        </div>
        <div style="height: 16px; width: var(--ds-space-800); background: var(--ds-color-primary); border-radius: var(--ds-radius-100);">
        </div>
      </div>
      <div style="display: flex; align-items: center; gap: var(--ds-space-300);">
        <div style="width: 120px; font: var(--ds-type-label);">
          space.1200
        </div>
        <div style="width: 64px; font: var(--ds-type-overline); color: var(--ds-color-text-secondary);">
